{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.4.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "StandaloneStreamChat",
    "id": "StandaloneStreamChat",
    "version": "0.10.0-6",
    "url": "https://github.com/Eigyn/StandaloneStreamChat",
    "additionalData": {
      "overrideSoName": "libStandaloneStreamChat.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./scripts/build.ps1"
      ],
      "clean": [
        "pwsh ./scripts/build.ps1 -clean"
      ],
      "qmod": [
        "pwsh ./scripts/build.ps1",
        "qpm qmod manifest",
        "qpm qmod zip",
        "pwsh ./scripts/package-release.ps1 -GameVersion 1.45.3"
      ]
    },
    "ndk": "^29.0.14206865",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "StandaloneStreamChat"
  },
  "dependencies": [
    {
      "id": "libil2cpp",
      "versionRange": "^0.5.0",
      "additionalData": {}
    },
    {
      "id": "beatsaber-hook",
      "versionRange": "^9.3.0",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4503.0.0",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.21.2",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.6.5",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false,
        "private": true
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {
        "private": true
      }
    },
    {
      "id": "flamingo",
      "versionRange": "~1.2.1",
      "additionalData": {}
    },
    {
      "id": "songcore",
      "versionRange": "^1.3.5",
      "additionalData": {}
    },
    {
      "id": "libcurl",
      "versionRange": "=8.5.0",
      "additionalData": {
        "private": true
      }
    }
  ]
}
